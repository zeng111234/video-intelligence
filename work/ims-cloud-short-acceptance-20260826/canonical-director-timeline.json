  "subtitles": [
    {
      "text": "很多朋友觉得车载之下装起来麻烦",
      "start": 0.0,
      "end": 2.3
    },
    {
      "text": "但这个不一样",
      "start": 2.3,
      "end": 3.24
    },
    {
      "text": "拧一下就能锁紧",
      "start": 3.24,
      "end": 4.6
    },
    {
      "text": "不用胶黏",
      "start": 4.6,
      "end": 5.38
    },
    {
      "text": "也不会卡住出风口",
      "start": 5.38,
      "end": 6.84
    },
    {
      "text": "更不用充电",
      "start": 6.84,
      "end": 7.68
    },
    {
      "text": "随便找个平整的地方",
      "start": 7.68,
      "end": 9.38
    },
    {
      "text": "一放就吸住了",
      "start": 9.38,
      "end": 10.38
    },
    {
      "text": "想换个位置",
      "start": 10.8,
      "end": 11.66
    },
    {
      "text": "反正拧一下就取下来",
      "start": 11.66,
      "end": 13.04
    }
  ],
