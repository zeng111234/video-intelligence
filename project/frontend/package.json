{
  "name": "video-frontend",
  "description": "VideoInsight 短视频创作工作台 Windows 客户端",
  "author": "VideoInsight",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:dir": "electron-builder --dir",
    "desktop:dist": "electron-builder --win nsis",
    "test:update": "node --test electron/*.test.cjs",
    "postinstall": "node ../../scripts/patch_electron_builder_windows.cjs",
    "preview": "vite preview",
    "test": "vitest run --exclude electron/*.test.cjs"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "24.1.3",
    "typescript": "^5.6.2",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.videoinsight.desktop",
    "productName": "VideoInsight",
    "asar": true,
    "electronDist": "desktop/electron-dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/environment.cjs",
      "electron/update.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/backend/VideoInsightBackend",
        "to": "backend"
      },
      {
        "from": "desktop/release-config.json",
        "to": "config/release.json"
      }
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VideoInsight"
    }
  }
}
