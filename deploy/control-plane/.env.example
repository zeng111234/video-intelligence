# 复制为 .env 后填写。不要把真实 .env 发给客户或提交 Git。
APP_ENV=production
ENABLE_DOCS=false

# 已解析到本服务器公网 IP 的域名；不要填写 http:// 或 https://。
CONTROL_PLANE_DOMAIN=video-api.example.com
CONTROL_PLANE_ALLOWED_HOSTS=video-api.example.com

# 2 核 4G 且与其他系统共用时的保守上限；这是最大值，不会预占资源。
# 后续升级服务器后可按监控结果调大，无需重新构建安装包。
CONTROL_PLANE_CPU_LIMIT=1.0
CONTROL_PLANE_MEMORY_LIMIT=1024m
CADDY_CPU_LIMIT=0.25
CADDY_MEMORY_LIMIT=256m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3

# 控制层会话仅保存不可逆哈希。
AUTH_SESSION_STORE=sqlite
ADMIN_TOKEN_TTL_SECONDS=43200
CUSTOMER_TOKEN_TTL_SECONDS=43200
# 单次写操作超过 15 分钟仍未完成时，只标记为“结果待核对”，绝不自动重提。
CONTROL_PLANE_OPERATION_PENDING_TIMEOUT_SECONDS=900

# 首次启动用这个密码创建 admin，登录后可在管理界面新增账号并改密码。
# 至少 16 位，使用密码管理器随机生成；不要复用个人密码。
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARACTERS

# 初次部署先保持全部供应商关闭。健康检查通过后，再按下方说明逐项开启；
# 没有改成 production/aliyun/shuying_cloud 的能力不会产生真实供应商费用。
COPYWRITING_MODE=sandbox
CRAWLER_PROVIDER_MODE=sandbox
VIDEO_EDITOR_PROVIDER_MODE=sandbox
# 转写正式启用时改为 cloud；部署检查会要求阿里云工作区、OSS 与访问密钥齐全。
ASR_MODE=sandbox
ASR_CLOUD_PROVIDER=aliyun
AVATAR_PROVIDER_MODE=sandbox
CRAWLER_ONEAPI_AUTO_ENABLED=false

# 正式供应商密钥只允许填写在服务器 .env，绝不填写到桌面配置或安装包。
COPYWRITING_API_KEY=
COPYWRITING_BASE_URL=https://api.deepseek.com
COPYWRITING_MODEL=deepseek-v4-flash
COPYWRITING_ESTIMATED_REQUEST_COST_CNY=
ONEAPI_API_KEY=
DASHSCOPE_API_KEY=
ALIYUN_MODEL_STUDIO_WORKSPACE_ID=
ALIYUN_VIDEO_EDITOR_REGION=cn-beijing
ALIYUN_OSS_LOCATION=oss-cn-beijing
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_MPS_PIPELINE_ID=
ALIYUN_MPS_TEMPLATE_ID_720P=
ALIYUN_MPS_TEMPLATE_ID_1080P=
# 免费素材检索：只用于语义候选搜索与缓存，未配置时按安全降级处理。
PEXELS_API_KEY=
PIXABAY_API_KEY=
# MiniMax 生图默认关闭；仅在服务器已配置新密钥且明确启用时使用。
VIDEO_IMAGE_PROVIDER_MODE=disabled
VIDEO_IMAGE_BASE_URL=https://api.minimaxi.com
MINIMAX_TOKEN_PLAN_KEY=
VIDEO_EDITOR_PRICE_VERSION=aliyun-cn-mainland-2026-07-29-safe-rough-cut
VIDEO_EDITOR_QUOTE_TTL_SECONDS=900

# 数影正式线路。只有 AVATAR_PROVIDER_MODE=shuying_cloud 且 ENABLED=true 才会调用。
SHUYING_AVATAR_ENABLED=false
SHUYING_AVATAR_BASE_URL=
SHUYING_AVATAR_API_CODE=
# 服务器部署包已带入训练完成的共享资产时可保持 []；不要在这里填写训练样本。
SHUYING_AVATAR_AVATARS_JSON=[]
SHUYING_AVATAR_VOICES_JSON=[]
SHUYING_AVATAR_RESULT_ALLOWED_HOSTS=
SHUYING_AVATAR_AUDIO_MODE=gateway_voice
SHUYING_AVATAR_AUDIO_UPLOAD_URL=
SHUYING_AVATAR_AUDIO_ALLOWED_HOSTS=
SHUYING_AVATAR_ASSETS_MANIFEST=data/avatar_assets/shuying_cloud.json
SHUYING_AVATAR_MODEL_UPLOAD_URL=
SHUYING_AVATAR_MODEL_UPLOAD_ALLOWED_HOSTS=
SHUYING_AVATAR_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
SHUYING_AVATAR_TIMEOUT_SECONDS=120
SHUYING_AVATAR_RESULT_TIMEOUT_SECONDS=120
SHUYING_AVATAR_MAX_SCRIPT_CHARS=2000
SHUYING_AVATAR_ESTIMATED_SECONDS=45

# 服务器与供应商通信超时；连接失败最多只自动重试一次。
CONTROL_PLANE_TIMEOUT_SECONDS=60
CONTROL_PLANE_UPLOAD_TIMEOUT_SECONDS=600
