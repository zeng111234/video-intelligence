# ===========================================
# 短视频智能生产系统 - 环境变量示例
# 复制此文件为 .env 并填写配置；.env 已被 Git 忽略
# 后端启动时会自动读取 .env，系统环境变量仍然优先
# ===========================================

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your-secret-key-change-this

# 服务端口
BACKEND_PORT=2001
FRONTEND_PORT=1001

# 数据库
DATABASE_PATH=data/video_intelligence.db

# ASR 语音识别 (local/cloud)
ASR_MODE=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# 关键词商业搜索
# sandbox：离线演示数据；oneapi：授权 OneAPI 真实查询；production：未接入供应商时禁用
CRAWLER_PROVIDER_MODE=sandbox
ONEAPI_API_KEY=
# 自动化试运行只启用抖音；多个值用英文逗号分隔
CRAWLER_ACTIVE_PLATFORMS=douyin

# AI 文案生成
# production：真实大模型；sandbox：仅自动化测试/演示模板
COPYWRITING_MODE=production
COPYWRITING_API_KEY=
COPYWRITING_BASE_URL=https://api.deepseek.com
COPYWRITING_MODEL=deepseek-v4-flash

# 数字人服务
# sandbox：本地演示闭环，不产生费用、不生成真实成片
# baidu_xiling：百度曦灵基础视频合成，需填写下方 BAIDU_XILING_* 配置
# internal：内部数字人服务适配器，需填写 AVATAR_SERVICE_* 配置
AVATAR_PROVIDER_MODE=sandbox
AVATAR_RESULT_DIRECTORY=data/avatar_results

# 百度曦灵基础视频合成
BAIDU_XILING_APP_ID=
BAIDU_XILING_APP_KEY=
BAIDU_XILING_FIGURE_ID=
BAIDU_XILING_VOICE_ID=
BAIDU_XILING_BASE_URL=https://open.xiling.baidu.com
BAIDU_XILING_FIGURE_NAME=百度曦灵公共数字人
BAIDU_XILING_VOICE_NAME=百度曦灵公共音色
BAIDU_XILING_CALLBACK_URL=
BAIDU_XILING_TRANSPARENT=false
BAIDU_XILING_TIMEOUT_SECONDS=20
BAIDU_XILING_MAX_SCRIPT_CHARS=20000
BAIDU_XILING_ESTIMATED_45S_COST_CNY=2.25

# 内部数字人服务（仅 AVATAR_PROVIDER_MODE=internal 时使用）
AVATAR_SERVICE_ENABLED=false
AVATAR_SERVICE_BASE_URL=
AVATAR_SERVICE_TOKEN=
AVATAR_SERVICE_TIMEOUT_SECONDS=20
AVATAR_RESULT_TIMEOUT_SECONDS=120

# 多平台发布账号配置
# 未取得官方权限前保持为空，系统会保留人工发布包/演示发布，不应伪造真实平台链接
PUBLISH_DOUYIN_ACCESS_TOKEN=
PUBLISH_DOUYIN_OPEN_ID=
PUBLISH_KUAISHOU_ACCESS_TOKEN=
PUBLISH_KUAISHOU_OPEN_ID=
PUBLISH_WECHAT_CHANNELS_ACCESS_TOKEN=
PUBLISH_WECHAT_CHANNELS_OPEN_ID=
PUBLISH_XIAOHONGSHU_ACCESS_TOKEN=
PUBLISH_XIAOHONGSHU_OPEN_ID=

# CORS
CORS_ORIGINS=http://localhost:1001
