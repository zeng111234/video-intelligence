# ===========================================
# 短视频智能生产系统 - 环境变量示例
# 复制此文件为 .env 并填写配置；.env 已被 Git 忽略
# 后端启动时会自动读取 .env，系统环境变量仍然优先
# ===========================================

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your-secret-key-change-this

# 服务端口
BACKEND_PORT=2001
FRONTEND_PORT=1001

# 数据库
DATABASE_PATH=data/video_intelligence.db

# ASR 语音识别 (local/cloud)
ASR_MODE=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# 云端轻量智能剪辑（与上面的 ASR_MODE 分离）
# sandbox：只验证页面、报价和审核契约；不调用云服务、不生成成片、不可交接发布
# aliyun：OSS → Fun-ASR → qwen-flash → 人工确认 → MPS
VIDEO_EDITOR_PROVIDER_MODE=sandbox
VIDEO_EDITOR_PRICE_VERSION=aliyun-cn-mainland-2026-07-28
VIDEO_EDITOR_QUOTE_TTL_SECONDS=900
DASHSCOPE_API_KEY=
ALIYUN_MODEL_STUDIO_WORKSPACE_ID=
ALIYUN_VIDEO_EDITOR_REGION=cn-beijing
ALIYUN_OSS_BUCKET=
ALIYUN_MPS_PIPELINE_ID=
ALIYUN_MPS_TEMPLATE_ID_720P=
ALIYUN_MPS_TEMPLATE_ID_1080P=
# 建议通过系统环境变量或 RAM 角色注入，切勿提交真实值
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 关键词商业搜索
# sandbox：离线演示数据；oneapi：授权 OneAPI 真实查询；production：未接入供应商时禁用
CRAWLER_PROVIDER_MODE=sandbox
ONEAPI_API_KEY=
# 自动化试运行只启用抖音；多个值用英文逗号分隔
CRAWLER_ACTIVE_PLATFORMS=douyin

# 抖音开放平台官方数据（热门视频榜 + 实时热点词，无需用户授权）
# 在 https://developer.open-douyin.com/ 创建应用后获取；
# 热榜 scope 为 data.external.billboard_hot_video，榜单统计最近 24 小时、每天 10 点前产出；
# 热点词约每 2 小时刷新。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 官方热榜 / 热点词开关；false 时 capabilities 报未启用且不调用官方接口
DOUYIN_OFFICIAL_HOT_ENABLED=true
DOUYIN_HOT_WORDS_ENABLED=true

# 抖音开放平台官方数据能力：官方热榜、实时热点词
DOUYIN_OFFICIAL_HOT_ENABLED=true
DOUYIN_HOT_WORDS_ENABLED=true
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# AI 文案生成
# production：真实大模型；sandbox：仅自动化测试/演示模板
COPYWRITING_MODE=production
COPYWRITING_API_KEY=
COPYWRITING_BASE_URL=https://api.deepseek.com
COPYWRITING_MODEL=deepseek-v4-flash
# 单次文案生成/改写的预计成本（人民币）；生产模式留空会按“费用未知”阻断启动。
COPYWRITING_ESTIMATED_REQUEST_COST_CNY=

# 数字人服务
# sandbox：本地演示闭环，不产生费用、不生成真实成片
# shuying_cloud：公司数影旧云网关；当前 aif 线路用云 TTS + 公司上传接口，再调用 /video、/videoDetail
# baidu_xiling：百度曦灵基础视频合成，需填写下方 BAIDU_XILING_* 配置
# internal：内部数字人服务适配器，需填写 AVATAR_SERVICE_* 配置
# local：本地 MuseTalk/SadTalker 命令式运行器；模型、权重、FFmpeg 和授权素材缺一不可
AVATAR_PROVIDER_MODE=sandbox
AVATAR_RESULT_DIRECTORY=data/avatar_results

# 公司数影旧云网关（仅 AVATAR_PROVIDER_MODE=shuying_cloud 时使用）
# 网关地址必须为 HTTPS；提交类请求不会自动重试，避免重复生成和重复计费。
# 资产 JSON 示例：[{"asset_id":"-11754","name":"公司数字人","authorized":true}]
SHUYING_AVATAR_ENABLED=false
SHUYING_AVATAR_BASE_URL=
SHUYING_AVATAR_API_CODE=
SHUYING_AVATAR_AVATARS_JSON=[]
SHUYING_AVATAR_VOICES_JSON=[]
SHUYING_AVATAR_RESULT_ALLOWED_HOSTS=
SHUYING_AVATAR_AUDIO_MODE=gateway_voice
SHUYING_AVATAR_AUDIO_UPLOAD_URL=
SHUYING_AVATAR_AUDIO_ALLOWED_HOSTS=
# 自定义云形象：训练视频通过该上传线路转存后调用 /aif/model。
# 留空时会沿用 SHUYING_AVATAR_AUDIO_UPLOAD_URL 与允许域名；可单独覆盖。
SHUYING_AVATAR_ASSETS_MANIFEST=data/avatar_assets/shuying_cloud.json
SHUYING_AVATAR_MODEL_UPLOAD_URL=
SHUYING_AVATAR_MODEL_UPLOAD_ALLOWED_HOSTS=
# 声音克隆与数字人生成共用 SHUYING_AVATAR_API_CODE；当地址以 /aif 结尾时，系统会自动使用同网关的 /ai 声音线路。
SHUYING_AVATAR_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
SHUYING_AVATAR_TIMEOUT_SECONDS=120
SHUYING_AVATAR_RESULT_TIMEOUT_SECONDS=120
SHUYING_AVATAR_MAX_SCRIPT_CHARS=2000
SHUYING_AVATAR_ESTIMATED_COST_CNY=
SHUYING_AVATAR_ESTIMATED_SECONDS=

# 本地数字人（GTX 1650 单任务）。所有命令均为本机受控命令，不能使用 shell 拼接。
# TTS 命令必须写出 {audio_output_path}；视频命令必须写出 {output_path}。
# 可用占位符：{script_text} {speech_rate} {avatar_path} {voice_path} {audio_path} {audio_output_path} {output_path}
# LOCAL_AVATAR_ASSETS_MANIFEST 是 JSON 文件，格式：{"assets":[{"asset_id":"avatar-001","kind":"avatar","name":"本人形象","path":"D:/assets/me.jpg","authorized":true},{"asset_id":"voice-001","kind":"voice","name":"本人音色","path":"D:/assets/me.wav","authorized":true}]}
LOCAL_AVATAR_ASSETS_MANIFEST=
LOCAL_AVATAR_OUTPUT_DIRECTORY=data/avatar_local_jobs
LOCAL_AVATAR_WORKING_DIRECTORY=
LOCAL_AVATAR_TTS_COMMAND=
LOCAL_AVATAR_TTS_REQUIRED_PATHS=
LOCAL_AVATAR_FAST_COMMAND=
LOCAL_AVATAR_FAST_REQUIRED_PATHS=
LOCAL_AVATAR_NATURAL_COMMAND=
LOCAL_AVATAR_NATURAL_REQUIRED_PATHS=

# 内部数字人服务（仅 AVATAR_PROVIDER_MODE=internal 时使用）
AVATAR_SERVICE_ENABLED=false
AVATAR_SERVICE_BASE_URL=
AVATAR_SERVICE_TOKEN=
AVATAR_SERVICE_TIMEOUT_SECONDS=20
AVATAR_RESULT_TIMEOUT_SECONDS=120

# 多平台发布账号配置
# 将下列值复制到项目根目录 .env 后填写。不要把真实 Key、Secret 提交到 Git 或发送到聊天。
# 抖音配置完成后，在“多平台发布”页点击“扫码连接抖音”；授权后的 token 由系统写入 .env，无需手填。
PUBLISH_DOUYIN_MODE=manual
PUBLISH_DOUYIN_CLIENT_KEY=
PUBLISH_DOUYIN_CLIENT_SECRET=
PUBLISH_DOUYIN_REDIRECT_URI=
PUBLISH_DOUYIN_ACCESS_TOKEN=
PUBLISH_DOUYIN_OPEN_ID=
PUBLISH_DOUYIN_REFRESH_TOKEN=
PUBLISH_DOUYIN_TOKEN_EXPIRES_AT=
PUBLISH_DOUYIN_REFRESH_EXPIRES_AT=

# 以下平台的 Key/Secret 预留给后续官方发布适配器；当前仍按人工发布助手执行。
PUBLISH_KUAISHOU_MODE=manual
PUBLISH_KUAISHOU_CLIENT_KEY=
PUBLISH_KUAISHOU_CLIENT_SECRET=
PUBLISH_KUAISHOU_ACCESS_TOKEN=
PUBLISH_KUAISHOU_OPEN_ID=
PUBLISH_WECHAT_CHANNELS_MODE=manual
PUBLISH_WECHAT_CHANNELS_CLIENT_KEY=
PUBLISH_WECHAT_CHANNELS_CLIENT_SECRET=
PUBLISH_WECHAT_CHANNELS_ACCESS_TOKEN=
PUBLISH_WECHAT_CHANNELS_OPEN_ID=
PUBLISH_XIAOHONGSHU_MODE=manual
PUBLISH_XIAOHONGSHU_CLIENT_KEY=
PUBLISH_XIAOHONGSHU_CLIENT_SECRET=
PUBLISH_XIAOHONGSHU_ACCESS_TOKEN=
PUBLISH_XIAOHONGSHU_OPEN_ID=

# CORS
CORS_ORIGINS=http://localhost:1001

# 抖音单链接转写（仅本机实验）。通过系统 Chrome/Edge 的临时无痕窗口读取公开页面响应；不读取 Cookie 或浏览器配置。
# 解析失败时页面会要求二次确认才调用 OneAPI。
DOUYIN_LOCAL_BROWSER_ENABLED=true
DOUYIN_BROWSER_CHANNEL=chrome
DOUYIN_BROWSER_TIMEOUT_SECONDS=35

# 抖音爆款发现：使用专用本机 Chrome 的可见搜索结果，不调用签名接口。
# 点击页面中的“打开专用浏览器”后，在独立窗口手动登录；资料目录位于 data/ 下且已被 Git 忽略。
DOUYIN_BROWSER_DISCOVERY_ENABLED=true
DOUYIN_BROWSER_DISCOVERY_PROFILE_DIR=data/browser_profiles/douyin
DOUYIN_BROWSER_DISCOVERY_DEBUG_PORT=19222
XIAOHONGSHU_BROWSER_DISCOVERY_ENABLED=true
XIAOHONGSHU_BROWSER_DISCOVERY_PROFILE_DIR=data/browser_profiles/xiaohongshu
XIAOHONGSHU_BROWSER_DISCOVERY_DEBUG_PORT=19223
KUAISHOU_BROWSER_DISCOVERY_ENABLED=true
KUAISHOU_BROWSER_DISCOVERY_PROFILE_DIR=data/browser_profiles/kuaishou
KUAISHOU_BROWSER_DISCOVERY_DEBUG_PORT=19224
BILIBILI_BROWSER_DISCOVERY_ENABLED=true
BILIBILI_BROWSER_DISCOVERY_PROFILE_DIR=data/browser_profiles/bilibili
BILIBILI_BROWSER_DISCOVERY_DEBUG_PORT=19225
# 默认为 false，阻止后端定时任务自动调用 OneAPI 产生搜索费用。
CRAWLER_ONEAPI_AUTO_ENABLED=false
