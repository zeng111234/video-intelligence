# ===========================================
# 短视频智能生产系统 - 环境变量示例
# 复制此文件为 .env 并填写配置；.env 已被 Git 忽略
# 后端启动时会自动读取 .env，系统环境变量仍然优先
# ===========================================

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your-secret-key-change-this

# 服务端口
BACKEND_PORT=2001
FRONTEND_PORT=1001

# 数据库
DATABASE_PATH=data/video_intelligence.db

# ASR 语音识别 (local/cloud)
ASR_MODE=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# 关键词商业搜索
# sandbox：离线演示数据；oneapi：授权 OneAPI 真实查询；production：未接入供应商时禁用
CRAWLER_PROVIDER_MODE=sandbox
ONEAPI_API_KEY=
# 自动化试运行只启用抖音；多个值用英文逗号分隔
CRAWLER_ACTIVE_PLATFORMS=douyin

# 抖音开放平台官方数据（热门视频榜 + 实时热点词，无需用户授权）
# 在 https://developer.open-douyin.com/ 创建应用后获取；
# 热榜 scope 为 data.external.billboard_hot_video，榜单统计最近 24 小时、每天 10 点前产出；
# 热点词约每 2 小时刷新。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 官方热榜 / 热点词开关；false 时 capabilities 报未启用且不调用官方接口
DOUYIN_OFFICIAL_HOT_ENABLED=true
DOUYIN_HOT_WORDS_ENABLED=true

# 抖音开放平台官方数据能力：官方热榜、实时热点词
DOUYIN_OFFICIAL_HOT_ENABLED=true
DOUYIN_HOT_WORDS_ENABLED=true
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

# 手机端豆包零成本提取（安卓测试机 + Appium）
# 只做本地 UI 自动化，不绕过登录、验证码或平台风控；App 弹窗会让任务失败并等待人工处理。
DOUBAO_MOBILE_APPIUM_URL=http://127.0.0.1:4723
ADB_PATH=
DOUBAO_ANDROID_PACKAGE=

# AI 文案生成
# production：真实大模型；sandbox：仅自动化测试/演示模板
COPYWRITING_MODE=production
COPYWRITING_API_KEY=
COPYWRITING_BASE_URL=https://api.deepseek.com
COPYWRITING_MODEL=deepseek-v4-flash

# 数字人服务
# sandbox：本地演示闭环，不产生费用、不生成真实成片
# baidu_xiling：百度曦灵基础视频合成，需填写下方 BAIDU_XILING_* 配置
# internal：内部数字人服务适配器，需填写 AVATAR_SERVICE_* 配置
# local：本地 MuseTalk/SadTalker 命令式运行器；模型、权重、FFmpeg 和授权素材缺一不可
AVATAR_PROVIDER_MODE=sandbox
AVATAR_RESULT_DIRECTORY=data/avatar_results

# 本地数字人（GTX 1650 单任务）。所有命令均为本机受控命令，不能使用 shell 拼接。
# TTS 命令必须写出 {audio_output_path}；视频命令必须写出 {output_path}。
# 可用占位符：{script_text} {speech_rate} {avatar_path} {voice_path} {audio_path} {audio_output_path} {output_path}
# LOCAL_AVATAR_ASSETS_MANIFEST 是 JSON 文件，格式：{"assets":[{"asset_id":"avatar-001","kind":"avatar","name":"本人形象","path":"D:/assets/me.jpg","authorized":true},{"asset_id":"voice-001","kind":"voice","name":"本人音色","path":"D:/assets/me.wav","authorized":true}]}
LOCAL_AVATAR_ASSETS_MANIFEST=
LOCAL_AVATAR_OUTPUT_DIRECTORY=data/avatar_local_jobs
LOCAL_AVATAR_WORKING_DIRECTORY=
LOCAL_AVATAR_TTS_COMMAND=
LOCAL_AVATAR_TTS_REQUIRED_PATHS=
LOCAL_AVATAR_FAST_COMMAND=
LOCAL_AVATAR_FAST_REQUIRED_PATHS=
LOCAL_AVATAR_NATURAL_COMMAND=
LOCAL_AVATAR_NATURAL_REQUIRED_PATHS=

# SadTalker 本地真实生成示例（Windows，无 Docker）。确认依赖和权重齐全后，可复制到 .env：
# AVATAR_PROVIDER_MODE=local
# LOCAL_AVATAR_ASSETS_MANIFEST=data/avatar_assets/local_sadtalker_example.json
# LOCAL_AVATAR_WORKING_DIRECTORY=
# LOCAL_AVATAR_TTS_COMMAND=powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local_avatar_tts_sapi.ps1
# LOCAL_AVATAR_TTS_REQUIRED_PATHS=scripts/local_avatar_tts_sapi.ps1
# LOCAL_AVATAR_NATURAL_COMMAND=powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local_avatar_sadtalker.ps1
# LOCAL_AVATAR_NATURAL_REQUIRED_PATHS=scripts/local_avatar_sadtalker.ps1;SadTalker/inference.py;local_models/sadtalker/.venv/Scripts/python.exe;local_models/sadtalker/.venv/Lib/site-packages/torch;local_models/sadtalker/.venv/Lib/site-packages/torchvision;SadTalker/checkpoints/SadTalker_V0.0.2_256.safetensors;SadTalker/checkpoints/mapping_00229-model.pth.tar
# SADTALKER_REPO_DIR=SadTalker
# SADTALKER_PYTHON=local_models/sadtalker/.venv/Scripts/python.exe
# SADTALKER_CHECKPOINT_DIR=SadTalker/checkpoints

# 百度曦灵基础视频合成
BAIDU_XILING_APP_ID=
BAIDU_XILING_APP_KEY=
BAIDU_XILING_FIGURE_ID=
BAIDU_XILING_VOICE_ID=
BAIDU_XILING_BASE_URL=https://open.xiling.baidu.com
BAIDU_XILING_FIGURE_NAME=百度曦灵公共数字人
BAIDU_XILING_VOICE_NAME=百度曦灵公共音色
BAIDU_XILING_CALLBACK_URL=
BAIDU_XILING_TRANSPARENT=false
BAIDU_XILING_TIMEOUT_SECONDS=20
BAIDU_XILING_MAX_SCRIPT_CHARS=20000
BAIDU_XILING_ESTIMATED_45S_COST_CNY=2.25

# 内部数字人服务（仅 AVATAR_PROVIDER_MODE=internal 时使用）
AVATAR_SERVICE_ENABLED=false
AVATAR_SERVICE_BASE_URL=
AVATAR_SERVICE_TOKEN=
AVATAR_SERVICE_TIMEOUT_SECONDS=20
AVATAR_RESULT_TIMEOUT_SECONDS=120

# 多平台发布账号配置
# 未取得官方权限前保持为空，系统会保留人工发布包/演示发布，不应伪造真实平台链接
PUBLISH_DOUYIN_ACCESS_TOKEN=
PUBLISH_DOUYIN_OPEN_ID=
PUBLISH_KUAISHOU_ACCESS_TOKEN=
PUBLISH_KUAISHOU_OPEN_ID=
PUBLISH_WECHAT_CHANNELS_ACCESS_TOKEN=
PUBLISH_WECHAT_CHANNELS_OPEN_ID=
PUBLISH_XIAOHONGSHU_ACCESS_TOKEN=
PUBLISH_XIAOHONGSHU_OPEN_ID=

# CORS
CORS_ORIGINS=http://localhost:1001

# 抖音单链接转写（仅本机实验）。通过系统 Chrome/Edge 的临时无痕窗口读取公开页面响应；不读取 Cookie 或浏览器配置。
# 解析失败时页面会要求二次确认才调用 OneAPI。
DOUYIN_LOCAL_BROWSER_ENABLED=true
DOUYIN_BROWSER_CHANNEL=chrome
DOUYIN_BROWSER_TIMEOUT_SECONDS=35

# 抖音爆款发现：使用专用本机 Chrome 的可见搜索结果，不调用签名接口。
# 点击页面中的“打开专用浏览器”后，在独立窗口手动登录；资料目录位于 data/ 下且已被 Git 忽略。
DOUYIN_BROWSER_DISCOVERY_ENABLED=false
DOUYIN_BROWSER_DISCOVERY_PROFILE_DIR=data/browser_profiles/douyin
DOUYIN_BROWSER_DISCOVERY_DEBUG_PORT=19222
# 默认为 false，阻止后端定时任务自动调用 OneAPI 产生搜索费用。
CRAWLER_ONEAPI_AUTO_ENABLED=false
